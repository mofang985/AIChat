# Copy this file to .env for local Docker compose usage.
# Do not commit real passwords.

POSTGRES_DB=aichat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# ASP.NET Core reads this environment variable as ConnectionStrings:DefaultConnection.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=aichat;Username=postgres;Password=CHANGE_ME

# Optional Web console API base URL for Vite.
VITE_API_BASE_URL=http://localhost:5218

# Optional LLM API keys. Keep real values only in local environment variables.
AIChat__Llm__DeepSeek__ApiKey=CHANGE_ME
AIChat__Llm__Tongyi__ApiKey=CHANGE_ME
AIChat__Llm__Ollama__ApiKey=ollama
